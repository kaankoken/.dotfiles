{
  "npmCommand": [
    "bun"
  ],
  "packages": [
    "npm:context-mode",
    "npm:pi-cursor-sdk",
    "npm:pi-hashline-edit-pro",
    "npm:bigpowers",
    "npm:pi-zentui",
    {
      "source": "npm:mitsupi",
      "extensions": [
        "extensions/answer.ts",
        "extensions/btw.ts",
        "extensions/context.ts",
        "extensions/go-to-bed.ts",
        "extensions/loop.ts"
      ],
      "skills": [],
      "prompts": [],
      "themes": []
    },
    "npm:@quintinshaw/pi-dynamic-workflows",
    "npm:@narumitw/pi-lsp",
    "npm:pi-web-access",
    "npm:pi-mcp-adapter"
  ],
  "lastChangelogVersion": "0.84.4",
  "theme": "dark",
  "defaultProvider": "cursor",
  "defaultModel": "opus-5@300k:fast",
  "defaultThinkingLevel": "xhigh",
  "images": {
    "blockImages": false
  },
  "showHardwareCursor": true,
  "terminal": {
    "showTerminalProgress": true,
    "clearOnShrink": true
  },
  "enableInstallTelemetry": false,
  "tuiMode": "fullscreen",
  "editorPaddingX": 1,
  "outputPad": 1,
  "steeringMode": "one-at-a-time",
  "treeFilterMode": "default"
}