Include ~/.orbstack/ssh/config

# Default GitHub (personal)
Host github.com
   HostName ssh.github.com
   Port 443
   User git
   IdentityFile ~/.ssh/personal
   IdentitiesOnly yes
   UseKeychain yes
   AddKeysToAgent yes

Host github-work
   HostName ssh.github.com
   Port 443
   User git
   IdentityFile ~/.ssh/work
   IdentitiesOnly yes
   UseKeychain yes
   AddKeysToAgent yes

# Cloudflare
Host auth.kkoken.com
  ProxyCommand /opt/homebrew/bin/cloudflared access ssh --hostname %h
  User legolas
  IdentitiesOnly yes
