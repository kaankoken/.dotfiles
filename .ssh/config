Include ~/.orbstack/ssh/config

# GitHub default (for plugins, etc.)
Host github.com
   HostName ssh.github.com
   Port 443
   User git
   IdentityFile ~/.ssh/personal
   AddKeysToAgent yes

# Personal
Host kaankoken-github.com
   HostName ssh.github.com
   Port 443
   UseKeychain yes
   AddKeysToAgent yes
   User git
   IdentityFile ~/.ssh/personal

