Include ~/.orbstack/ssh/config

# Default GitHub (personal)
Host github.com
   HostName ssh.github.com
   Port 443
   User git
   IdentityFile ~/.ssh/personal
   UseKeychain yes
   AddKeysToAgent yes

# Personal (alias — only useful if it points to a *different* key)
Host kaankoken-github.com
   HostName ssh.github.com
   Port 443
   User git
   IdentityFile ~/.ssh/personal
   UseKeychain yes
   AddKeysToAgent yes
