Include ~/.orbstack/ssh/config

# Default GitHub (personal)
Host github.com
   HostName ssh.github.com
   Port 443
   User git
   IdentityFile ~/.ssh/personal
   IdentitiesOnly yes
   UseKeychain yes
   AddKeysToAgent yes

Host github-work
   HostName ssh.github.com
   Port 443
   User git
   IdentityFile ~/.ssh/work
   IdentitiesOnly yes
   UseKeychain yes
   AddKeysToAgent yes
