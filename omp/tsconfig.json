{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "bun-types"
    ],
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "tests/**/*.ts",
    "extensions/**/*.ts"
  ]
}
