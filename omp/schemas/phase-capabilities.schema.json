{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omp/schemas/phase-capabilities.schema.json",
  "title": "PhaseCapabilityManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phase",
    "agent",
    "runId",
    "issueId",
    "canonicalRoots",
    "network",
    "operations"
  ],
  "properties": {
    "phase": {
      "type": "string",
      "enum": [
        "Init",
        "Research",
        "Spec",
        "Plan",
        "BiteSize",
        "Implement",
        "Integration",
        "Milestone",
        "PR"
      ]
    },
    "agent": { "type": "string", "minLength": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "issueId": { "type": "string" },
    "canonicalRoots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "worktree", "runTemp"],
      "properties": {
        "repo": { "type": "string", "minLength": 1 },
        "worktree": { "type": "string", "minLength": 1 },
        "runTemp": { "type": "string", "minLength": 1 },
        "integration": { "type": "string" },
        "migrationTargets": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["none", "read-only-docs", "full"]
        },
        "allowedHosts": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "fs.read.repo",
          "fs.write.lane",
          "fs.write.runTemp",
          "fs.write.integration",
          "fs.write.migrationTarget",
          "bd.read",
          "bd.write.controller",
          "git.read",
          "git.write.lane",
          "git.write.integration",
          "git.push",
          "gh.pr",
          "cli.execute",
          "skill.read",
          "network.fetch"
        ]
      }
    }
  }
}
