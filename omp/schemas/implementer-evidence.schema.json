{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "omp/schemas/implementer-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "issueId",
    "branch",
    "worktreePath",
    "headSha",
    "changedFiles",
    "red",
    "green",
    "notes"
  ],
  "properties": {
    "issueId": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "worktreePath": { "type": "string", "minLength": 1 },
    "headSha": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "changedFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "red": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exitCode", "summary"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "exitCode": { "type": "integer" },
        "summary": { "type": "string" }
      }
    },
    "green": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exitCode", "summary"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "exitCode": { "type": "integer", "const": 0 },
        "summary": { "type": "string" }
      }
    },
    "notes": { "type": "string" }
  }
}
