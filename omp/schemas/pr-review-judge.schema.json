{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dotfiles.local/schemas/pr-review-judge-v1.schema.json",
  "title": "JudgeResult v1",
  "type": "object",
  "properties": {
    "schema_version": { "const": 1 },
    "run_nonce": { "type": "string", "minLength": 32, "maxLength": 256 },
    "snapshot_nonce": { "type": "string", "minLength": 32, "maxLength": 256 },
    "call_nonce": { "type": "string", "minLength": 32, "maxLength": 256 },
    "head_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "diff_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "adjudications": {
      "type": "array",
      "minItems": 0,
      "maxItems": 200,
      "items": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "source_finding_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 200,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 3, "maxLength": 134, "pattern": "^(fable|sol):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
              },
              "decision": { "enum": ["accept", "request_changes"] },
              "rationale": { "type": "string", "minLength": 1, "maxLength": 8192 },
              "anchor_source_finding_id": { "type": "string", "minLength": 3, "maxLength": 134, "pattern": "^(fable|sol):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
              "body": { "type": "string", "minLength": 1, "maxLength": 65536 }
            },
            "required": ["source_finding_ids", "decision", "rationale", "anchor_source_finding_id", "body"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "source_finding_ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 200,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 3, "maxLength": 134, "pattern": "^(fable|sol):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
              },
              "decision": { "const": "reject" },
              "rationale": { "type": "string", "minLength": 1, "maxLength": 8192 }
            },
            "required": ["source_finding_ids", "decision", "rationale"],
            "additionalProperties": false
          }
        ]
      }
    },
    "overall_rationale": { "type": "string", "minLength": 1, "maxLength": 8192 }
  },
  "required": ["schema_version", "run_nonce", "snapshot_nonce", "call_nonce", "head_sha", "diff_digest", "adjudications", "overall_rationale"],
  "additionalProperties": false
}
