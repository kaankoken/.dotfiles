font-family = "JetBrains Mono Nerd Font"
font-size = 16
theme = tokyonight
cursor-style = block
adjust-cell-height = 0%
background-opacity = 0.80
mouse-hide-while-typing = true
mouse-scroll-multiplier = 1.5
macos-titlebar-style = hidden
window-padding-balance = true
window-save-state = always
window-colorspace = "display-p3"
command = /Users/legolas/.dotfiles/bin/nu-for-ghostty
cursor-style-blink = true
window-padding-x = 2,4
window-padding-y = 0
clipboard-read = allow
clipboard-write = allow
quit-after-last-window-closed = true
confirm-close-surface = false
copy-on-select = true
# Left Option = typing (Turkish Q); Right Option = Alt for terminal apps
macos-option-as-alt = right
auto-update = on
# Do NOT remap shift+enter to text:\n — that collapses Shift+Enter into a plain
# newline and breaks TUIs (Claude Code, Codex, …) that need the Kitty keyboard
# protocol to distinguish Shift+Enter (newline) from Enter (submit).
# Ghostty supports this natively; leave Shift+Enter unbound.
shell-integration = nushell

# ---------------------------------------------------------------------------
# AeroSpace pass-through — keep in sync with aerospace.toml
# See docs/keybindings.md
# ---------------------------------------------------------------------------

# Focus
keybind = cmd+h=ignore
keybind = cmd+j=ignore
keybind = cmd+k=ignore
keybind = cmd+l=ignore

# Move window
keybind = cmd+shift+h=ignore
keybind = cmd+shift+j=ignore
keybind = cmd+shift+k=ignore
keybind = cmd+shift+l=ignore

# Workspaces
keybind = cmd+1=ignore
keybind = cmd+2=ignore
keybind = cmd+3=ignore
keybind = cmd+4=ignore
keybind = cmd+5=ignore
keybind = cmd+6=ignore
keybind = cmd+7=ignore

# Send to workspace
keybind = cmd+shift+1=ignore
keybind = cmd+shift+2=ignore
keybind = cmd+shift+3=ignore
keybind = cmd+shift+4=ignore
keybind = cmd+shift+5=ignore
keybind = cmd+shift+6=ignore
keybind = cmd+shift+7=ignore

# Workspace nav
keybind = cmd+shift+p=ignore
keybind = cmd+shift+n=ignore
keybind = cmd+shift+tab=ignore

# Resize
keybind = cmd+minus=ignore
keybind = cmd+equal=ignore

# Monitors
keybind = cmd+ctrl+s=ignore
keybind = cmd+ctrl+g=ignore
keybind = cmd+ctrl+tab=ignore

# Cheatsheet + leader
keybind = cmd+slash=ignore
keybind = cmd+semicolon=ignore

custom-shader-animation = true
