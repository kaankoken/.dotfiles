// Zellij — Ctrl hierarchy (see docs/keybindings.md)
// Direct Ctrl = daily · Ctrl+a = leader · Ctrl+/ = cheatsheet
// Turkish Q: no Alt binds · no tmux/tab/pane mode soup

keybinds clear-defaults=true {
    normal {
        // Pane focus
        bind "Ctrl h" { MoveFocus "left"; }
        bind "Ctrl j" { MoveFocus "down"; }
        bind "Ctrl k" { MoveFocus "up"; }
        bind "Ctrl l" { MoveFocus "right"; }

        // Move pane
        bind "Ctrl Shift h" { MovePane "left"; }
        bind "Ctrl Shift j" { MovePane "down"; }
        bind "Ctrl Shift k" { MovePane "up"; }
        bind "Ctrl Shift l" { MovePane "right"; }

        // Tabs
        bind "Ctrl Left" { GoToPreviousTab; }
        bind "Ctrl Right" { GoToNextTab; }
        bind "Ctrl 1" { GoToTab 1; }
        bind "Ctrl 2" { GoToTab 2; }
        bind "Ctrl 3" { GoToTab 3; }
        bind "Ctrl 4" { GoToTab 4; }
        bind "Ctrl 5" { GoToTab 5; }
        bind "Ctrl t" { NewTab; }
        bind "Ctrl w" { CloseFocus; }

        // Resize
        bind "Ctrl -" { Resize "Decrease"; }
        bind "Ctrl =" { Resize "Increase"; }
        bind "Ctrl +" { Resize "Increase"; }

        // Cheatsheet
        bind "Ctrl /" {
            Run "/Users/legolas/.dotfiles/bin/show-keybinds" "zellij" {
                close_on_exit true
            }
        }

        // Leader (Zellij built-in mode name "tmux" — used only as shallow leader, not classic tmux)
        bind "Ctrl a" { SwitchToMode "tmux"; }
    }

    locked {
        bind "Ctrl g" { SwitchToMode "normal"; }
    }

    // Shallow leader — structural pane ops (not mode soup)
    tmux {
        bind "Esc" { SwitchToMode "normal"; }
        bind "Ctrl c" { SwitchToMode "normal"; }
        bind "Ctrl a" { SwitchToMode "normal"; }

        // Split (new pane in direction)
        bind "h" { NewPane "left"; SwitchToMode "normal"; }
        bind "j" { NewPane "down"; SwitchToMode "normal"; }
        bind "k" { NewPane "up"; SwitchToMode "normal"; }
        bind "l" { NewPane "right"; SwitchToMode "normal"; }
        bind "n" { NewPane; SwitchToMode "normal"; }

        bind "x" { CloseFocus; SwitchToMode "normal"; }
        bind "f" { ToggleFloatingPanes; SwitchToMode "normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "normal"; }

        // Move pane sub-mode
        bind "w" { SwitchToMode "move"; }

        // Cheatsheet
        bind "i" {
            Run "/Users/legolas/.dotfiles/bin/show-keybinds" "zellij" {
                close_on_exit true
            }
            SwitchToMode "normal"
        }
        bind "/" {
            Run "/Users/legolas/.dotfiles/bin/show-keybinds" "zellij" {
                close_on_exit true
            }
            SwitchToMode "normal"
        }
    }

    move {
        bind "Esc" { SwitchToMode "normal"; }
        bind "h" { MovePane "left"; SwitchToMode "normal"; }
        bind "j" { MovePane "down"; SwitchToMode "normal"; }
        bind "k" { MovePane "up"; SwitchToMode "normal"; }
        bind "l" { MovePane "right"; SwitchToMode "normal"; }
    }

    shared_except "locked" {
        bind "Ctrl g" { SwitchToMode "locked"; }
    }
}

plugins {
    about location="zellij:about"
    compact-bar location="zellij:compact-bar"
    configuration location="zellij:configuration"
    filepicker location="zellij:strider" {
        cwd "/"
    }
    plugin-manager location="zellij:plugin-manager"
    session-manager location="zellij:session-manager"
    status-bar location="zellij:status-bar"
    strider location="zellij:strider"
    tab-bar location="zellij:tab-bar"
    welcome-screen location="zellij:session-manager" {
        welcome_screen true
    }
}

load_plugins {
}

theme "gruvbox-dark"
default_shell "nu"
default_layout "compact"
