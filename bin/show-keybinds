#!/bin/sh
# show-keybinds — open per-app cheatsheet (Swift app only; no spammy markdown open)
# Usage: show-keybinds [aerospace|zellij|ghostty|nvim|shell|all]
# Set KEYBINDS_FALLBACK=md to open docs/keybindings.md when the app is missing.
set -eu
APP="${1:-all}"
DOTFILES="${HOME}/.dotfiles"
JSON="${DOTFILES}/.config/keybinds/keybinds.json"
MD="${DOTFILES}/docs/keybindings.md"

case "$APP" in
  aerospace|zellij|ghostty|nvim|shell|all) ;;
  *) echo "Unknown app: $APP (use aerospace|zellij|ghostty|nvim|shell|all)" >&2; exit 1 ;;
esac

if [ ! -f "$JSON" ]; then
  echo "Missing keybind catalog: $JSON" >&2
  exit 1
fi

# Prefer Swift app; override with KEYBINDS_APP
if [ -n "${KEYBINDS_APP:-}" ]; then
  set -- "$KEYBINDS_APP"
else
  set -- KeybindCheatsheet Keybinds
fi

for candidate in "$@"; do
  if /usr/bin/open -a "$candidate" --args --app "$APP" --json "$JSON" 2>/dev/null; then
    exit 0
  fi
done

# Optional fallback only when explicitly requested (avoids reopening the md constantly)
if [ "${KEYBINDS_FALLBACK:-}" = "md" ] && [ -f "$MD" ]; then
  /usr/bin/open "$MD"
  exit 0
fi

# Quiet notice — does not open a document window
if command -v osascript >/dev/null 2>&1; then
  /usr/bin/osascript -e "display notification \"No KeybindCheatsheet app yet. JSON: ${JSON}\" with title \"Keybinds (${APP})\"" 2>/dev/null || true
fi

exit 0
