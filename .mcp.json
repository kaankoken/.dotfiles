{
  "mcpServers": {
    "parallel-search": {
      "url": "https://search.parallel.ai/mcp",
      "protocolVersion": "auto",
      "directTools": true
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "protocolVersion": "auto"
    },
    "github": {
      "url": "https://api.githubcopilot.com/mcp",
      "auth": "bearer",
      "bearerToken": "!gh auth token --hostname github.com",
      "protocolVersion": "auto"
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.6.0"
      ]
    }
  }
}
